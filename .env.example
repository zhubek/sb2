# Обязательно: секрет подписи JWT-сессий (openssl rand -base64 32)
AUTH_SECRET=

# Опционально: Google OAuth (Google Cloud Console → Credentials).
# Без этих ключей кнопка «Продолжить с Google» отключена.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Backend is required for CMS content. Browser requests use the authenticated Next BFF.
NEXT_PUBLIC_API_URL=/api/backend
API_URL=http://127.0.0.1:3030/api

# Панель /admin: обязательный пароль для production; AUTH_SECRET также обязателен.
# Без пароля локальный вход доступен только в next dev на localhost.
ADMIN_PASSWORD=

# Legacy import directory only. Live content and answers are stored in PostgreSQL.
CMS_DATA_DIR=
