# Обязательно: секрет подписи JWT-сессий (openssl rand -base64 32)
AUTH_SECRET=

# Опционально: Google OAuth (Google Cloud Console → Credentials).
# Без этих ключей кнопка «Продолжить с Google» отключена.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# REST API бекенда (backend/, NestJS). Без него страницы работают
# на мок-данных. NEXT_PUBLIC_ — для браузера, API_URL — для сервера Next.
NEXT_PUBLIC_API_URL=http://localhost:3002/api
API_URL=http://localhost:3002/api
