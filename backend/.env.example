# Postgres (docker compose up -d поднимает локальную БД на 5434)
DATABASE_URL=postgresql://sb2:sb2dev@localhost:5434/sb2?schema=public

# Порт API (фронтенд на 3001)
PORT=3002

# Разрешённый origin для CORS
CORS_ORIGIN=http://localhost:3001

# Legacy CMS import directory; live publications are stored in PostgreSQL.
# CMS_DATA_DIR=C:/path/to/sb2/.data/cms
# NAV_DATA_DIR=C:/path/to/sb2/lib/nav
# Optional local PostgreSQL: npm run db:local (set DATABASE_URL to a free loopback port)

# Must equal the frontend AUTH_SECRET (at least 32 characters).
CMS_AUTH_SECRET=
HOST=127.0.0.1
